{
  "name": "codigodoleo/wp-html-forms-hardening",
  "description": "Reusable hardening package for WordPress HTML Forms with reCAPTCHA, nonce enforcement, and admin settings.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Codigo do Oleo",
      "homepage": "https://github.com/codigodoleo"
    }
  ],
  "require": {
    "php": ">=8.2",
    "roots/acorn": "^5.0 || ^6.0"
  },
  "autoload": {
    "psr-4": {
      "CodigoDoOleo\\HtmlFormsHardening\\": "src/"
    }
  },
  "extra": {
    "acorn": {
      "providers": [
        "CodigoDoOleo\\HtmlFormsHardening\\Providers\\HtmlFormsHardeningServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
